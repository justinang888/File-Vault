@model SharedFileViewModel
@{
    ViewData["Title"] = "Download file";
    var now = DateTime.UtcNow;
}

@functions {
    static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    static string Ext(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.TrimStart('.');
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.ToUpperInvariant();
    }
}

<div class="auth">
    <h1 class="auth__title">Someone shared a file with you</h1>
    <p class="auth__subtitle">
        @(Model.CanEdit
            ? "You have editor access: download, rename, or replace this file."
            : "Review the details below, then confirm to download.")
    </p>

    <div class="access-note">
        <span class="share-badge @(Model.CanEdit ? "share-badge--role" : "share-badge--on")">@(Model.CanEdit ? "Editor" : "Viewer")</span>
        <span>@(Model.CanEdit ? "You can manage this file." : "You can view and download this file.")</span>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="flash flash--success" role="status">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            <span>@TempData["Message"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash flash--error" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="share-preview">
        <div class="share-preview__file">
            <span class="file-chip">@Ext(Model.FileName)</span>
            <span class="file-name">@Model.FileName</span>
        </div>
        <dl class="share-preview__meta">
            <div>
                <dt>Size</dt>
                <dd>@FormatSize(Model.FileSize)</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.FileType) ? "Unknown" : Model.FileType)</dd>
            </div>
            <div>
                <dt>Expires</dt>
                <dd>@(Model.ExpiresAt.HasValue ? Model.ExpiresAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "Never")</dd>
            </div>
            @if (Model.DownloadsRemaining.HasValue)
            {
                <div>
                    <dt>Downloads left</dt>
                    <dd>@Model.DownloadsRemaining</dd>
                </div>
            }
        </dl>
    </div>

    <form asp-action="DownloadShared" asp-route-token="@Model.Token" method="post">
        <button type="submit" class="btn btn--primary auth__submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M7 11l5 5 5-5" /><path d="M4 20h16" /></svg>
            Download file
        </button>
    </form>

    @if (Model.CanEdit)
    {
        <div class="editor-actions">
            <h2 class="editor-actions__title">Manage this file</h2>

            <form asp-action="SharedRename" asp-route-token="@Model.Token" method="post" class="editor-actions__row">
                <input type="text" name="newName" value="@Model.FileName" aria-label="New file name" class="share-url" required />
                <button type="submit" class="btn btn--ghost">Rename</button>
            </form>

            <form asp-action="SharedReplace" asp-route-token="@Model.Token" method="post" enctype="multipart/form-data" class="editor-actions__row">
                <input type="file" name="file" aria-label="Replacement file" required />
                <button type="submit" class="btn btn--ghost">Replace</button>
            </form>

            <form asp-action="SharedRevoke" asp-route-token="@Model.Token" method="post" onsubmit="return confirm('Revoke this link? It will stop working for everyone.');">
                <button type="submit" class="btn btn--ghost share-revoke">Revoke link</button>
            </form>
        </div>
    }

    <p class="auth__alt">Only download files from people you trust.</p>
</div>
