@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-head">
    <h1>Privacy Policy</h1>
    <p>How FileVault handles the files and data you store with us.</p>
</div>

<article class="prose">
    <section class="prose__section">
        <h2>Files you upload</h2>
        <p>
            Files you upload are stored so you can list and download them later. Only share files
            you have the right to distribute, and avoid uploading sensitive personal information.
        </p>
    </section>

    <section class="prose__section">
        <h2>Data we keep</h2>
        <p>
            For each file we retain basic metadata: its name, type, size, and upload date. This
            information is used solely to display your file list and enable downloads.
        </p>
    </section>

    <section class="prose__section">
        <h2>Contact</h2>
        <p>
            Questions about this policy? Reach out to your FileVault administrator for details on
            retention and deletion.
        </p>
    </section>
</article>
