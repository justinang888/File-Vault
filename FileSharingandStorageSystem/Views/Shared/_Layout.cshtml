@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FileVault</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FileSharingandStorageSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" asp-controller="Files" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
                    </svg>
                </span>
                <span class="brand__name">FileVault</span>
            </a>
            <nav class="app-nav">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="app-nav__link" asp-controller="Files" asp-action="Index">Files</a>
                    <a class="app-nav__link" asp-controller="Files" asp-action="Privacy">Privacy</a>
                    <div class="user-menu">
                        <span class="user-menu__email" title="@UserManager.GetUserName(User)">@UserManager.GetUserName(User)</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="linkbtn">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="app-nav__link" asp-controller="Files" asp-action="Privacy">Privacy</a>
                    <a class="app-nav__link" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="app-nav__link" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </nav>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-footer__inner">
            <span>&copy; @DateTime.Now.Year FileVault</span>
            <a asp-controller="Files" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
