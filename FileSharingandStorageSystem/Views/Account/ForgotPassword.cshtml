@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth">
    <h1 class="auth__title">Reset your password</h1>
    <p class="auth__subtitle">Enter your email and we'll send you a reset link.</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn--primary auth__submit">Send reset link</button>
    </form>

    <p class="auth__alt">
        Remembered it? <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
