@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth">
    <h1 class="auth__title">Welcome back</h1>
    <p class="auth__subtitle">Sign in to access your files.</p>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field field--check">
            <input asp-for="RememberMe" />
            <label asp-for="RememberMe"></label>
        </div>

        <button type="submit" class="btn btn--primary auth__submit">Sign in</button>
    </form>

    <p class="auth__alt">
        <a asp-controller="Account" asp-action="ForgotPassword">Forgot your password?</a>
    </p>
    <p class="auth__alt">
        Don't have an account? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Create one</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
