@{
    ViewData["Title"] = "Password updated";
}

<div class="auth">
    <h1 class="auth__title">Password updated</h1>
    <p class="auth__subtitle">Your password has been changed. You can now sign in with it.</p>

    <a asp-controller="Account" asp-action="Login" class="btn btn--primary auth__submit">Sign in</a>
</div>
